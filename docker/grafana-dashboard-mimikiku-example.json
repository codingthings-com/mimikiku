      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "id": 11
    },
    {
      "type": "stat",
      "title": "Lines sent (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "refId": "A",
          "expr": "sum(increase(mimikiku_segments_total{service_namespace=\"mimikiku\", deployment_environment_name=~\"$env\", mimikiku_instance=~\"$instance\"}[24h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
