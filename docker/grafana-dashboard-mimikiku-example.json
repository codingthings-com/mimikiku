        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Servers reporting in",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "id": 13
    },
    {
      "type": "row",
      "title": "Recordings",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 14,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active recordings by instance",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "refId": "A",
          "expr": "sum by (mimikiku_instance) (mimikiku_recordings_active{service_namespace=\"mimikiku\", deployment_environment_name=~\"$env\", mimikiku_instance=~\"$instance\"})",
          "legendFormat": "{{mimikiku_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Recordings started",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "refId": "A",
          "expr": "sum by (client, saved) (increase(mimikiku_recordings_total{service_namespace=\"mimikiku\", deployment_environment_name=~\"$env\", mimikiku_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{client}} saved={{saved}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "client: session = web app, token = API token (mimikiku-capture, iOS app); saved=false is mimikiku-capture --no-save",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Audio transcribed / min",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
