# Compose variables for docker/docker-compose.yml. Copy to docker/.env (gitignored).
# All optional. App settings (HF token, PUBLIC_ORIGIN, STORE_AUDIO) go in the
# repo root .env.

# Use another Mongo instead of the compose one, e.g. one shared by Mimikiku
# servers on several machines (each server needs to reach it).
# MONGO_URI=mongodb://mongo-host:27017/mimikiku

# Telemetry (OTLP/HTTP) is off by default; see OLLY.md. Either point it at any
# collector reachable from the container:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example.internal:4318
# or, when an olly_network docker network exists, docker-start.sh adds
# compose.olly.yml, which exports to olly-collector:4318 on it. Set this empty
# (OLLY_OTLP_URL=) to turn that off, or to another collector on that network.
# OLLY_OTLP_URL=http://olly-collector:4318
# Environment label on the dashboards.
# DEPLOY_ENV=production
# This server's name on the Grafana dashboard and the admin Service page; give
# each machine its own when running several.
# MIMIKIKU_INSTANCE=mimikiku
