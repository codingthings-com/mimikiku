# Mimikiku app settings. Copy to .env (gitignored) and fill in.
# docker/docker-compose.yml passes this file to the server container (env_file).
# Mongo and telemetry addresses are set by compose; see docker/.env.example.

# Hugging Face token (Read role) for downloading the models. The current models
# don't need one, but future ones may, and anonymous downloads have lower rate
# limits. Treat it as a secret.
HUGGING_FACE_HUB_TOKEN=

# First admin, created on the first start (only while there are no users yet).
# Change the password after signing in (Account); later edits here don't touch
# existing accounts. Leave empty to create the admin with
# `docker compose ... exec server python manage_users.py create-admin <email>`.
MIMIKIKU_ADMIN_EMAIL=admin@example.com
MIMIKIKU_ADMIN_PASSWORD=change-me-now

# Where users reach the web app. Used for the set-password links printed by
# manage_users.py, and accepted as an origin for sign-in cookies behind a
# reverse proxy (comma-separate several).
# PUBLIC_ORIGIN=https://mimikiku.example.com

# Keep each recording's audio with its transcript (in Mongo/GridFS, ~115MB per
# hour), downloadable as WAV from the Export menu. Off unless 1.
# STORE_AUDIO=1

# Write transcript text to the server logs (and to Loki, with telemetry on).
# Off by default: logs then show speakers, timings and word counts only.
# LOG_TRANSCRIPTS=1

# Models (core settings, read at startup; restart to change). Each loads the
# named Hugging Face commit. Leave empty for the defaults in server/config.py;
# a different model without a revision loads that repo's main branch.
# MIMIKIKU_ASR_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
# MIMIKIKU_ASR_REVISION=ebe59e5a817142986528bbbee5dba8db7b38ed50
# MIMIKIKU_DIAR_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
# MIMIKIKU_DIAR_REVISION=cd03eee90fbec18297ac31b8c21546e596b7f71c
